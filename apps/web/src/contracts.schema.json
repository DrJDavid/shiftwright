        "kind",
        "strength",
        "source",
        "status"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ConstraintKind": {
      "description": "The COMPLETE set of rules the engine understands. Anything else a leader says\ngoes to StoreConfig.unmodeled. params schema per kind:\n\nmin_shift_length         {minutes:int}\nmax_shift_length         {minutes:int}\nmin_rest_between_shifts  {minutes:int}                         # anti-\"clopen\"\nmax_days_per_week        {days:int}\nmax_consecutive_days     {days:int}\nmin_hours_week           {}  (uses Employee.min_hours_week; soft; weight = $/hour short)\nnot_together             {employee_ids:[a,b]}                  # no overlapping shifts; soft weight = $/overlapping hour\nfair_spread              {shift_class:\"open\"|\"close\"|\"weekend\", max_per_employee:int}\n                         # open = starts before store open; close = ends after store close\n                         # soft weight = $ per excess occurrence\nalways_staffed           {role_id:str, windows:\"store_hours\"|\"staff_hours\"}\n                         # e.g. leader_on_duty must be covered whenever open\npreferred_role           {employee_id:str, role_id:str}        # soft weight = $/hour NOT in that role\nweek_stability           {}  (soft weight = $/hour changed vs previous_schedule; optional)\n\n`applies_to_employee_ids` = None means everyone.",
      "enum": [
        "min_shift_length",
        "max_shift_length",
        "min_rest_between_shifts",
        "max_days_per_week",
        "max_consecutive_days",
        "min_hours_week",
        "not_together",
        "fair_spread",
        "always_staffed",
        "preferred_role",
        "week_stability"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "DayHours": {

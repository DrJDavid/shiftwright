# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
AGENT_MODEL=
BASELINE_MODELS=
MESSENGER=mock          # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=        # public URL for the Twilio webhook
DATABASE_URL=sqlite:///./shiftwright.db
DEMO_PHONE_1=           # the two verified demo phones (WS4 demo store)
DEMO_PHONE_2=
SMS_ALLOWLIST=          # comma-separated E.164 numbers Twilio may text (plus DEMO_PHONE_1/2); empty = only demo phones
DEMO_KEY=               # if set, mutating /api/stores/* routes require header X-Demo-Key
MAX_TEXTS_PER_STORE_HOUR=20
MOCK_AUTOREPLY=script   # mock only: script | prob | off
MOCK_REPLY_DELAY_S=4
MOCK_SEED=417
